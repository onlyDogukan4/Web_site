{
  "name": "moderra-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:server": "node scripts/test-server.js",
    "test:all": "npm run test && npm run test:e2e",
    "build:html": "node scripts/build-html.js",
    "sync:navbars": "node scripts/sync-site-navbars.js",
    "verify:api": "node scripts/verify-api-count.js",
    "vercel-build": "npm run build:html && npm run verify:api"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "mongodb": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "vitest": "^3.2.4"
  }
}
