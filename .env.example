# MongoDB (üretimde zorunlu)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# PayTR — üretimde mutlaka ortam değişkeni kullanın
PAYTR_MERCHANT_ID=your_merchant_id
PAYTR_MERCHANT_KEY=your_merchant_key
PAYTR_MERCHANT_SALT=your_merchant_salt
PAYTR_TEST_MODE=1

# Site URL (PayTR yönlendirme adresleri)
SITE_URL=https://your-domain.com

# Test/CI — gerçek PayTR API çağrısı yapılmaz
PAYTR_MOCK=true
USE_MEMORY_DB=true

# AI — Groq (ücretsiz katman, yüksek limit): https://console.groq.com
# Tek anahtar yeterli (chat + sepet danışmanı)
GROQ_CHAT_API_KEY=
GROQ_API_KEY=
# Opsiyonel model (varsayılan: llama-3.3-70b-versatile)
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
